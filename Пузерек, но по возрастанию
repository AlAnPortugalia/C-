#include <iostream>
#include <vector>

void bubbleSort(std::vector<int>& v) {
    int n = v.size();
    // Внешний цикл: проходит по всем элементам
    for (int i = 0; i < n - 1; i++) {
        // Внутренний цикл: сравнивает соседние элементы
        // После i-го прохода последние i элементов уже на своих местах
        for (int j = 0; j < n - i - 1; j++) {
            // Если элементы расположены в неправильном порядке, меняем их местами
            if (v[j] > v[j + 1]) {
                std::swap(v[j], v[j + 1]);
            }
        }
    }
}
int main() {
    // Пример массива
    std::vector<int> v = {5, 1, 4, 2, 8};

    // Сортировка
    bubbleSort(v);

    // Вывод результата
    for (int i : v) {
        std::cout << i << " ";
    }
    std::cout << std::endl;

    return 0;
}
