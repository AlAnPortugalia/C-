//K - Король
//Q - Королева
//B - Слон
//R - Ладья
//K - Конь
//P - Пешка
#include <iostream>
using namespace std;

int main() {
    const int n = 8;
    char board[n][n];

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            board[i][j] = '.';
        }
    }

    int row = 2;
    int col = 3;
    char shape = 'Q';

    if (shape == 'R') {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (row == i && col != j || row != i && col == j) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    if (shape == 'B') {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i - j == row - col || j + i == row + col) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    else if (shape == 'K') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if ((i - row == -2 && j - col == -1) || (i - row == -2 && j - col == 1) ||
                    (i - row == -1 && j - col == -2) || (i - row == -1 && j - col == 2) ||
                    (i - row == 1 && j - col == -2) || (i - row == 1 && j - col == 2) ||
                    (i - row == 2 && j - col == -1) || (i - row == 2 && j - col == 1)) {
                    board[i][j] = '*';
                }
            }
        }
    }
    else if (shape == 'P') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (i == row + 1 && j == col) {
                    board[i][j] = '*';
                }
                if (row == 1 && i == row + 2 && j == col) {
                    board[i][j] = '*';
                }
                if (i == row - 1 && j == col) {
                    board[i][j] = '*';
                }
                if (row == 1 && i == row - 2 && j == col) {
                    board[i][j] = '*';
                }
            }
        }
    }
    
    else if (shape == 'Q') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (row == i && col != j || row != i && col == j) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
                if (i - j == row - col || j + i == row + col) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }
    else if (shape == 'L') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if ((i - row >= -1 && i - row <= 1) && (j - col >= -1 && j - col <= 1) && ((i - row != 0) || (j - col != 0))) {
                    board[i][j] = '*';
                }
            }
        }
    }

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout << board[i][j] << " ";
        }
        cout << endl;
    }
}
