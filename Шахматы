//K - Король
//Q - Королева
//B - Слон
//R - Ладья
//K - Конь
//P - Пешка
#include <iostream>
#include <string>
using namespace std;
const int n = 8;

bool FoundKing(char board[n][n], int& kingRow, int& kingCol) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (board[i][j] == 'L') {
                kingRow = i;
                kingCol = j;
                return true;
            }
        }
    }
    return false;
}

int main() {
    char board[n][n];
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            board[i][j] = '.';
        }
    }
    

    int row = 2;
    int col = 3;
    string color = "black";
    char shape = 'L';

    if (shape == 'R') {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (row == i && col != j || row != i && col == j) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    if (shape == 'B') {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i - j == row - col || j + i == row + col) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    if (shape == 'K') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if ((i - row == -2 && j - col == -1) || (i - row == -2 && j - col == 1) ||
                    (i - row == -1 && j - col == -2) || (i - row == -1 && j - col == 2) ||
                    (i - row == 1 && j - col == -2) || (i - row == 1 && j - col == 2) ||
                    (i - row == 2 && j - col == -1) || (i - row == 2 && j - col == 1)) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    if (color == "black") {
        if (shape == 'P') {
            for (int i = 0; i < n; ++i) {
                for (int j = 0; j < n; ++j) {
                    if ((i == row - 1 || i == row - 2) && j == col) {
                        board[i][j] = '*';
                    }
                    if (row == i && col == j) {
                        board[i][j] = shape;
                    }
                }
            }
        }
    }

    if (color == "white") {
        if (shape == 'P') {
            for (int i = 0; i < n; ++i) {
                for (int j = 0; j < n; ++j) {
                    if ((i == row + 1 || i == row + 2) && j == col) {
                        board[i][j] = '*';
                    }
                    if (row == i && col == j) {
                        board[i][j] = shape;
                    }
                }
            }
        }
    }

    if (shape == 'Q') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (row == i && col != j || row != i && col == j) {
                    board[i][j] = '*';
                }
                if (i - j == row - col || j + i == row + col) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    if (shape == 'L') {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if ((i - row >= -1 && i - row <= 1) && (j - col >= -1 && j - col <= 1) && ((i - row != 0) || (j - col != 0))) {
                    board[i][j] = '*';
                }
                if (row == i && col == j) {
                    board[i][j] = shape;
                }
            }
        }
    }

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout << board[i][j] << " ";
        }
        cout << endl;
    }
    
    int kingCol = 0, kingRow = 0;
    if (FoundKing(board, kingRow, kingCol)) {
        cout << "King: " << kingRow << " " << kingCol << endl;
    } else {
        cout << "Not found king" << endl;
    }
}
