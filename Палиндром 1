#include <iostream>
#include <string>
using namespace std;

int main() {
    string s;
    cin >> s;

    if (s.empty()) {
        cout << "Yes" << endl;
    }

    int counter = 0;
    int n = s.size();

    for (int i = 0; i < n / 2; ++i) {
        if (s[i] != s[n - 1 - i]) {
            counter++;
            break;  
        }
    }

    if (counter == 0) {
        cout << "Polindrom" << endl;
    }
    else {
        cout << "no Polindrom" << endl;
    }
}
