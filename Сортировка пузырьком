#include <iostream>
#include <string>

void bubbleSortByLength(std::string arr[], int n) {
    for (int i = 0; i < n - 1; ++i) {
        bool swapped = false;

        for (int j = 0; j < n - i - 1; ++j) {
            if (arr[j].length() > arr[j + 1].length()) {
                std::string temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
                swapped = true;
            }
        }

        if (!swapped) {
            break;
        }
    }
}

int main() {
    std::string names[] = {"Анна", "Иван", "Екатерина", "Боб", "Александр", "Ли"};
    int n = sizeof(names) / sizeof(names[0]);

    bubbleSortByLength(names, n);

    for (int i = 0; i < n; ++i) {
        std::cout << names[i] << "\n";
    }

    return 0;
}
