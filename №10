//Дана строка. Показать номера символов, совпадающих с последним символом строки.
#include <iostream>
#include <string>
using namespace std;

int main() {
    string s = "abcdfff";

    if (s.empty()) {
        cout << "Пусто" << endl;
    }

    cout << "Последний символ: " << s.back() << endl;
    cout << "Номера символов, совпадающих с последним: ";

    for (int i = 0; i < s.size(); ++i) {
        if (s[i] == s.back()) {
            cout << (i + 1) << " ";
        }
    }
}
